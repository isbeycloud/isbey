{
  "name": "i-bey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "efatura:preflight": "node --import tsx tools/hizli-canli-hazirlik.mjs",
    "start": "node --import tsx tools/start-production.mjs",
    "preflight": "node --import tsx tools/production-preflight.mjs",
    "release:package": "node tools/package-release.mjs",
    "test": "node tools/test-local.mjs",
    "test:e2e": "playwright test",
    "release:check": "npm run build && npm run lint && npm test && npm run test:e2e && npm run security-audit",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server",
    "security-audit": "npm audit --audit-level=high",
    "ci": "npm run release:check",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "headroom-ai": "^0.37.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
