# ─── İŞBEY CLOUD — Ortam Değişkenleri Şablonu ────────────────────────────────
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri doldurun.
# UYARI: .env dosyasını asla Git'e commit etmeyin!

# ─── JWT Güvenlik ────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ─── Kimlik Bilgisi Kasası (server/security/credentialVault.ts) ──────────────
# Firma web servis şifreleri (e-Fatura ayarları, bayi portalCredentials.wsPassword)
# veritabanında AES-256-GCM ile şifrelenir. Anahtar kaynağı önceliği:
#   1) CREDENTIAL_ENCRYPTION_KEY (aşağıdaki) — 32 bayt, base64 (44 karakter) VEYA hex (64 karakter)
#   2) Tanımsızsa JWT_SECRET'ten HKDF-SHA256 ile türetilir (kurulum kolaylığı)
# Üretmek için:  openssl rand -base64 32
#
# UYARI-1: Değer tanımlı ama 32 bayta çözümlenemiyorsa uygulama AÇIK HATA verir;
#          sessizce JWT_SECRET'e DÜŞMEZ (yanlış anahtarla şifreleyip kaydı okunamaz
#          hâle getirmemek için).
# UYARI-2: Anahtarı DEĞİŞTİRİRSENİZ mevcut `enc:v1:` kayıtları çözülemez. Önce
#          migrasyon/rotasyon planı yapın (docs/30).
# UYARI-3: JWT_SECRET'i değiştirmek de (türetilmiş anahtar nedeniyle) aynı etkiyi yapar.
CREDENTIAL_ENCRYPTION_KEY=

# ─── HIZLI BİLİŞİM ENTEGRASYON BİLGİLERİ ─────────────────────────────────────
# Canlı sistem:  https://econnect.hizliteknoloji.com.tr
# Test sistemi:  https://econnecttest.hizliteknoloji.com.tr
HIZLI_BILISIM_API_URL=https://econnecttest.hizliteknoloji.com.tr
HIZLI_BILISIM_API_KEY=YOUR_API_KEY
HIZLI_BILISIM_SECRET_KEY=YOUR_SECRET_KEY
HIZLI_BILISIM_WS_USERNAME=YOUR_WS_USERNAME
HIZLI_BILISIM_WS_PASSWORD=YOUR_WS_PASSWORD
HIZLI_BILISIM_IS_TEST_MODE=true
HIZLI_BILISIM_TIMEOUT=30000

# Canlı (production) Hızlı Bilişim endpoint'ine geçiş anahtarı.
# VARSAYILAN BOŞ = KAPALI (fail-closed). Yalnızca TÜM QA kalemleri PASS olduktan
# ve ayrı onay fazı verildikten SONRA 'true' yapılır; o zaman bile
# `switch-mode`, `save-credentials`, `encrypt` ve `test-connection` uçları
# production'a geçebilir. Gerekçe: CLAUDE.md md.1.
HIZLI_BILISIM_ALLOW_PROD=

# ─── Webhook Secret'ları (FAZ 25.3 #2 — fallback YASAK, tanımsızsa webhook fail-closed 503) ──
PAYMENT_WEBHOOK_SECRET=
WEBHOOK_SECRET=

# ─── FAZ 25.4 Production Security (server/middleware/productionSecurity.ts) ──
# Ters proxy güveni (rate limiter'ın gerçek istemci IP'sini görmesi için).
# VARSAYILAN BOŞ = trust proxy KAPALI = güvenli. Yalnızca uygulama bir ters proxy
# (nginx / Cloudflare / yük dengeleyici) ARKASINDA çalışıyorsa doldurun; aksi
# hâlde tüm istekler proxy IP'sinde toplanır. `true` YALNIZCA tüm proxy'ler sizinse.
# TRUST_PROXY=loopback|1|true
TRUST_PROXY=
# CORS allowlist — tanımsızsa mevcut açık davranış korunur (geliştirme akışı bozulmaz).
# Production'da virgülle ayrılmış origin listesi verin:
# CORS_ALLOW_ORIGINS=https://app.isbey.com,https://admin.isbey.com
CORS_ALLOW_ORIGINS=
# Geliştirmede localhost origin'lerine izin (allowlist aktifken dahi) — production'da boş/false bırakın
LOCAL_DEV_ALLOW=
# HSTS başlığı (yalnızca HTTPS arkasındaysa true yapın)
ENABLE_HSTS=
# SPA için opsiyonel CSP başlığı — tanımlıysa birebir gönderilir (kör default SPA'yı kırar)
CSP_HEADER=
# Login rate limit üst sınırı (15 dk / IP başına deneme). TANIMSIZSA VARSAYILAN 20 GEÇERLİDİR.
# Bu anahtarı YALNIZCA doğrulama koşusu gibi, aynı IP'den çok sayıda login yapan
# otomatik suitler için yükseltin. Production'da boş bırakın (varsayılan 20 korunur).
# LOGIN_RATE_LIMIT_MAX=500
# Mobil login rate limit üst sınırı (tanımsızsa varsayılan 30)
# MOBILE_RATE_LIMIT_MAX=60

# ─── FAZ 25.5 Backup / Retention (server/db/storage.ts) ─────────────────────
# Tutulacak maksimum yedek sayısı (en yeni N yedek her zaman korunur)
BACKUP_RETENTION_COUNT=20
# Bu günden eski yedekler silinir (gün); en yeni 1 yedek her koşulda kalır
BACKUP_RETENTION_DAYS=30

# ─── Firma Bilgileri ─────────────────────────────────────────────────────────
HIZLI_BILISIM_FIRMA_ADI=FİRMA ADI LTD. ŞTİ.
HIZLI_BILISIM_VKN=0000000000
HIZLI_BILISIM_FIRMA_ID=0000

# ─── Şifrelenmiş Kimlik Bilgileri ────────────────────────────────────────────
# (UtilEncrypt endpoint'i tarafından otomatik doldurulur — elle değiştirmeyin)
HIZLI_BILISIM_HASHED_USERNAME=
HIZLI_BILISIM_HASHED_PASSWORD=

# ─── Uygulama Ayarları & FAZ 27 Ortam Ayrımı ─────────────────────────────────
NODE_ENV=development
PORT=3001
# Production/staging geliştirme DB'sine geri dönmez. Production dosyası önceden hazırlanmalıdır.
DATABASE_PATH=

# İlk dağıtım doğrulamasında false tutun; true olduğunda entegratör oturum/yenileme ve belge kuyruğu çalışır.
INTEGRATION_JOBS_ENABLED=false
